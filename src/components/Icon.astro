---
// Inline SVG icons exported from Figma (src/assets/icons). Role icons use currentColor.
const files = import.meta.glob('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
interface Props { name: string; size?: number; class?: string }
const { name, size = 32, class: cls = '' } = Astro.props;
const svg = (files[`../assets/icons/${name}.svg`] || '').replace(/width="[\d.]+" height="[\d.]+"/, `width="${size}" height="${size}"`);
---
<span class={`icon ${cls}`} aria-hidden="true" set:html={svg} />

<style>
  .icon { display: inline-flex; flex: none; line-height: 0; }
</style>
